{
  "name": "galaxy-campaign-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788 --ip 127.0.0.1 --show-interactive-dev-session false",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply galaxy-map-saves --local",
    "db:migrate:remote": "wrangler d1 migrations apply galaxy-map-saves --remote",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.6",
    "jose": "^6.2.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-zoom-pan-pinch": "^4.0.3",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.156.2"
  }
}
