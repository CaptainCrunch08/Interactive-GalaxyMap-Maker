{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Galaxy map dev server",
      "type": "shell",
      "command": "node",
      "args": ["scripts/ensure-dev.mjs"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
